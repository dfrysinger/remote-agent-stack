<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Agent Stack tmux keychain bootstrap LaunchAgent.

  Installed into ~/Library/LaunchAgents/com.dfrysinger.tmux-keychain-bootstrap.plist
  by install.sh. Two placeholders are substituted at install time:
    __SCRIPT_PATH__       — absolute path to tmux-keychain-bootstrap.sh
    __TMUX_SOCKET_PATH__  — default tmux socket for this UID

  Loaded under the user's GUI/Aqua login session (gui/<uid>) so the tmux
  server it spawns inherits the full login-keychain search list. Without
  this, the first `agent-stack <backend> <name>` call after a reboot bootstraps the tmux
  server from the SSH login shell instead, and every subsequent session
  inside that server is keychain-restricted — see the script's header
  comment for the full story.

  RunAtLoad fires once at GUI login. KeepAlive uses PathState as a
  watchdog: the agent is kept eligible to run as long as the tmux
  socket does NOT exist. So:
    - At login: socket missing → script fires → creates server →
      socket appears → launchd lets the script exit and idles.
    - On `tmux kill-server`: socket disappears → launchd refires the
      script → creates a fresh GUI-context server → socket reappears
      → launchd idles again.
  Net effect: self-healing. No manual launchctl kickstart needed.
  launchd's default 10s ThrottleInterval bounds the relaunch rate, so
  if the script ever fails to create a server (e.g. tmux binary
  missing) it gets re-fired at most once every ~10s instead of in a
  tight loop. That's a deliberate feature, not a bug: it means the
  agent self-recovers as soon as the user fixes the underlying
  problem, at the cost of some log noise in the meantime.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dfrysinger.tmux-keychain-bootstrap</string>

  <key>ProgramArguments</key>
  <array>
    <string>__SCRIPT_PATH__</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>PathState</key>
    <dict>
      <key>__TMUX_SOCKET_PATH__</key>
      <false/>
    </dict>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/com.dfrysinger.tmux-keychain-bootstrap.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/com.dfrysinger.tmux-keychain-bootstrap.err.log</string>
</dict>
</plist>
