#!/bin/bash
# Toggle bounded macOS Screen Sharing over a Tailscale TCP forward.

set -euo pipefail

COMMAND="${1:-status}"
[ $# -gt 0 ] && shift
HOURS=1
HOURS_SET=false
JSON=false
for arg in "$@"; do
  if [ "$arg" = "--json" ]; then
    JSON=true
  elif [ "$COMMAND" = "on" ] && [ "$HOURS_SET" = false ]; then
    HOURS="$arg"
    HOURS_SET=true
  else
    echo "Unexpected argument: $arg" >&2
    exit 2
  fi
done

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/remote-agent-stack"
CONFIG_FILE="$CONFIG_DIR/config"
ROOT_CONFIG_FILE="${SS_ROOT_CONFIG_FILE:-/usr/local/etc/remote-agent-stack/screen-sharing.conf}"
ROOT_HELPER=/usr/local/libexec/ss-on-demand
ROOT_HELPER="${SS_ROOT_HELPER:-$ROOT_HELPER}"
SUDO_BIN="${SS_SUDO_BIN:-sudo}"
ROOT_STATE=/var/db/remote-agent-stack/screen-sharing-lease
SS_UNIT=system/com.apple.screensharing
TAILSCALE_BIN="${TAILSCALE_BIN:-$(command -v tailscale 2>/dev/null || true)}"

read_config_var() {
  local name="$1"
  [ -f "$CONFIG_FILE" ] || return 0
  awk -F= -v name="$name" '
    $1 == name {
      sub(/^[^=]*=/, "")
      gsub(/^"|"$/, "")
      print
      exit
    }
  ' "$CONFIG_FILE"
}

PORT="$(
  awk -F= '$1=="SCREEN_SHARING_PORT" {
    gsub(/\047/, "", $2)
    print $2
    exit
  }' "$ROOT_CONFIG_FILE" 2>/dev/null || true
)"
PORT="${PORT:-$(read_config_var SCREEN_SHARING_PORT)}"
PORT="${PORT:-15900}"
case "$PORT" in
  *[!0-9]*|"") echo "Invalid SCREEN_SHARING_PORT in $CONFIG_FILE" >&2; exit 1 ;;
esac
if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
  echo "SCREEN_SHARING_PORT must be between 1 and 65535" >&2
  exit 1
fi

run_timeout() {
  local seconds="$1"
  shift
  /usr/bin/perl -e '
    my $seconds = shift @ARGV;
    $SIG{ALRM} = sub { die "command timed out\n" };
    alarm $seconds;
    exec @ARGV or die "exec failed: $!\n";
  ' "$seconds" "$@"
}

tailscale_hostname() {
  [ -n "$TAILSCALE_BIN" ] || return 1
  run_timeout 10 "$TAILSCALE_BIN" status --json 2>/dev/null |
    /usr/bin/python3 -c '
import json, re, sys
value = ((json.load(sys.stdin).get("Self") or {}).get("DNSName") or "").rstrip(".")
if not re.fullmatch(r"(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", value):
    raise SystemExit(1)
print(value.split(".", 1)[0])
'
}

json_result() {
  /usr/bin/python3 - "$@" <<'PY'
import json, sys
keys = sys.argv[1::2]
values = sys.argv[2::2]
parsed = {}
for key, value in zip(keys, values):
    if value in ("true", "false"):
        parsed[key] = value == "true"
    elif value.isdigit():
        parsed[key] = int(value)
    elif value == "null":
        parsed[key] = None
    else:
        parsed[key] = value
print(json.dumps(parsed, separators=(",", ":")))
PY
}

case "$COMMAND" in
  on)
    case "$HOURS" in
      1|2|3|4|5|6|7|8) ;;
      *) echo "Usage: agent-screen on [1-8] [--json]" >&2; exit 2 ;;
    esac
    HOSTNAME="$(tailscale_hostname)" || {
      echo "Could not resolve this machine's Tailscale DNS name; Screen Sharing was not enabled." >&2
      exit 1
    }
    OUTPUT="$("$SUDO_BIN" -n "$ROOT_HELPER" on "$HOURS")"
    CLEANUP_ON_FAILURE=true
    cleanup_failed_on() {
      local status=$?
      trap - EXIT
      if [ "$status" -ne 0 ] && [ "$CLEANUP_ON_FAILURE" = true ]; then
        "$SUDO_BIN" -n "$ROOT_HELPER" off >/dev/null 2>&1 || true
      fi
      exit "$status"
    }
    trap cleanup_failed_on EXIT
    CREATED="$(printf '%s\n' "$OUTPUT" | awk -F= '$1=="CREATED_LEASE"{print $2}')"
    EXPIRY="$(printf '%s\n' "$OUTPUT" | awk -F= '$1=="EXPIRY_EPOCH"{print $2}')"
    HELPER_PORT="$(printf '%s\n' "$OUTPUT" | awk -F= '$1=="SCREEN_SHARING_PORT"{print $2}')"
    case "$CREATED" in
      true) ;;
      false) CLEANUP_ON_FAILURE=false ;;
      *) echo "Privileged helper returned invalid lease ownership" >&2; exit 1 ;;
    esac
    case "$EXPIRY" in
      *[!0-9]*|"") echo "Privileged helper returned an invalid expiry" >&2; exit 1 ;;
    esac
    case "$HELPER_PORT" in
      *[!0-9]*|"") echo "Privileged helper returned an invalid port" >&2; exit 1 ;;
    esac
    if [ "$HELPER_PORT" -lt 1 ] || [ "$HELPER_PORT" -gt 65535 ]; then
      echo "Privileged helper returned an out-of-range port" >&2
      exit 1
    fi
    PORT="$HELPER_PORT"
    URL="screens://$HOSTNAME:$PORT"
    if $JSON; then
      json_result enabled true createdLease "${CREATED:-false}" expiryEpoch "$EXPIRY" port "$PORT" url "$URL"
    else
      OFF_AT="$(date -r "$EXPIRY" '+%Y-%m-%d %H:%M:%S')"
      echo "Screen Sharing is ON until $OFF_AT."
      echo "Open: $URL"
      echo "Force off: agent-screen off"
    fi
    CLEANUP_ON_FAILURE=false
    trap - EXIT
    ;;
  off)
    "$SUDO_BIN" -n "$ROOT_HELPER" off
    if $JSON; then
      json_result enabled false
    else
      echo "Screen Sharing is OFF."
    fi
    ;;
  status)
    ACTIVE=false
    EXPIRY=0
    if [ -f "$ROOT_STATE" ]; then
      EXPIRY="$(awk -F= '$1=="EXPIRY_EPOCH"{print $2}' "$ROOT_STATE" 2>/dev/null || echo 0)"
      case "$EXPIRY" in ""|*[!0-9]*) EXPIRY=0 ;; esac
      [ "$EXPIRY" -gt "$(date +%s)" ] && ACTIVE=true
    fi
    HOSTNAME="$(tailscale_hostname 2>/dev/null || true)"
    URL=null
    [ -n "$HOSTNAME" ] && URL="screens://$HOSTNAME:$PORT"
    if $JSON; then
      json_result enabled "$ACTIVE" expiryEpoch "$EXPIRY" port "$PORT" url "$URL"
      exit 0
    fi
    echo "--- bounded lease ---"
    if $ACTIVE; then
      echo "active until $(date -r "$EXPIRY" '+%Y-%m-%d %H:%M:%S')"
      [ "$URL" != null ] && echo "Open: $URL"
    else
      echo "(inactive)"
    fi
    echo "--- Screen Sharing daemon ---"
    if launchctl print "$SS_UNIT" >/dev/null 2>&1; then
      launchctl print "$SS_UNIT" 2>&1 | grep -E "^[[:space:]]*state =" | head -1 || true
    else
      echo "(not bootstrapped)"
    fi
    echo "--- Tailscale mapping ---"
    if [ -n "$TAILSCALE_BIN" ]; then
      run_timeout 10 "$TAILSCALE_BIN" serve status 2>&1 |
        grep -E "$PORT|5900" || echo "(no managed mapping)"
    else
      echo "(tailscale not found)"
    fi
    echo "--- Screen capture grant ---"
    SS_LOG="$(log show --last 2d --predicate 'process == "ScreensharingAgent"' --style compact 2>/dev/null || true)"
    FAIL_TS="$(printf '%s\n' "$SS_LOG" | grep -F "Cannot get shareable content" | tail -1 | cut -c1-23)"
    OK_TS="$(printf '%s\n' "$SS_LOG" | grep -E "\(ScreenCaptureKit\).*(SCStream|stopCapture|startCapture)" | tail -1 | cut -c1-23)"
    if [ -z "$FAIL_TS" ] && [ -z "$OK_TS" ]; then
      echo "(no recent Screens session to inspect)"
    elif [ -n "$FAIL_TS" ] && { [ -z "$OK_TS" ] || [[ "$FAIL_TS" > "$OK_TS" ]]; }; then
      echo "WARNING: last session could not capture the screen ($FAIL_TS)."
      echo "Toggle System Settings > General > Sharing > Screen Sharing off and on."
    else
      echo "last capture succeeded ($OK_TS)"
    fi
    ;;
  *)
    echo "Usage: agent-screen {on [1-8] [--json] | off [--json] | status [--json]}" >&2
    exit 2
    ;;
esac
