#!/usr/bin/env bash
# agent — launch or attach to a named Copilot, Claude, or Codex session
#
# The canonical command selects a backend explicitly. The three long aliases
# select it from their invocation name:
#   remote-agent <copilot|claude|codex> <name>
#   copilot-agent <name>
#   claude-agent <name>
#   codex-agent <name>
#
# Each backend has a separate workspace root and tmux namespace.
#
# Configuration (env or ~/.config/remote-agent-stack/config):
#   COPILOT_WORKSPACE_BASE   default: ~/Library/CloudStorage/Dropbox/copilot-workspace
#   CLAUDE_WORKSPACE_BASE    default: ~/Library/CloudStorage/Dropbox/claude-workspace
#   CODEX_WORKSPACE_BASE     default: ~/Library/CloudStorage/Dropbox/codex-workspace
#   COPILOT_BIN              default: copilot
#   CLAUDE_BIN               default: claude
#   CODEX_BIN                default: codex
#   AGENT_DIR_PREFIX         default: agent-
#   ALLOW_ALL                default: false
#     copilot: --allow-all
#     claude : --dangerously-skip-permissions
#     codex  : --dangerously-bypass-approvals-and-sandbox
#   MAILBOX_INTEGRATION      default: false
#   SESSION_WARN_MB          default: 300  (copilot only; 0 disables)
#     Offer to retire a session whose event log has grown past this size.

set -euo pipefail

# ---- backend dispatch + args -----------------------------------------------

INVOCATION="$(basename "$0")"

usage_global() {
  cat <<USAGE
Usage: $INVOCATION <copilot|claude|codex> <Name>
  Launch or reattach to a named agent session.

Examples:
  $INVOCATION copilot alpha
  $INVOCATION claude alpha
  $INVOCATION codex alpha

Options:
  -h, --help   Show this help and exit.
USAGE
}

usage_backend() {
  local command
  if [ "$INVOCATION" = "remote-agent" ] || [ "$INVOCATION" = "agent" ]; then
    command="$INVOCATION $BACKEND"
  else
    command="$INVOCATION"
  fi
  cat <<USAGE
Usage: $command <Name>
  Launch or reattach to a named $BACKEND agent session.

  Example: $command alpha

Options:
  -h, --help   Show this help and exit.

Config:
  ~/.config/remote-agent-stack/config
  Env: COPILOT_WORKSPACE_BASE, CLAUDE_WORKSPACE_BASE, CODEX_WORKSPACE_BASE,
       COPILOT_BIN, CLAUDE_BIN, CODEX_BIN, AGENT_DIR_PREFIX, ALLOW_ALL,
       MAILBOX_INTEGRATION
USAGE
}

case "$INVOCATION" in
  remote-agent|agent)
    case "${1:-}" in
      -h|--help)
        [ $# -eq 1 ] || { usage_global >&2; exit 2; }
        usage_global
        exit 0
        ;;
      copilot|claude|codex)
        BACKEND="$1"
        shift
        ;;
      *)
        usage_global >&2
        exit 2
        ;;
    esac
    ;;
  copilot-agent) BACKEND="copilot" ;;
  claude-agent)  BACKEND="claude" ;;
  codex-agent)   BACKEND="codex" ;;
  *)
    echo "Unsupported invocation name: $INVOCATION" >&2
    usage_global >&2
    exit 2
    ;;
esac

case "${1:-}" in
  -h|--help)
    [ $# -eq 1 ] || { usage_backend >&2; exit 2; }
    usage_backend
    exit 0
    ;;
esac

if [ $# -ne 1 ] || [ -z "${1:-}" ] || [ "${1#-}" != "$1" ] ||
   [ "${1#*/}" != "$1" ]; then
  usage_backend >&2
  exit 2
fi

NAME="$1"

# ---- config ----------------------------------------------------------------

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/remote-agent-stack"
CONFIG_FILE="$CONFIG_DIR/config"

if [ -f "$CONFIG_FILE" ]; then
  # shellcheck source=/dev/null
  . "$CONFIG_FILE"
fi

# Pre-Claude installs used WORKSPACE_BASE for Copilot. Preserve that value so
# upgrading the script does not silently switch existing agents to a new root.
if [ -z "${COPILOT_WORKSPACE_BASE:-}" ] && [ -n "${WORKSPACE_BASE:-}" ]; then
  COPILOT_WORKSPACE_BASE="$WORKSPACE_BASE"
fi

: "${COPILOT_WORKSPACE_BASE:=$HOME/Library/CloudStorage/Dropbox/copilot-workspace}"
: "${CLAUDE_WORKSPACE_BASE:=$HOME/Library/CloudStorage/Dropbox/claude-workspace}"
: "${CODEX_WORKSPACE_BASE:=$HOME/Library/CloudStorage/Dropbox/codex-workspace}"
: "${COPILOT_BIN:=copilot}"
: "${CLAUDE_BIN:=claude}"
: "${CODEX_BIN:=codex}"
: "${AGENT_DIR_PREFIX:=agent-}"
: "${SESSION_WARN_MB:=300}"

case "$BACKEND" in
  copilot)
    AGENT_BIN="$COPILOT_BIN"
    WORKSPACE_BASE="$COPILOT_WORKSPACE_BASE"
    SESSION_PREFIX="copilot-"
    ;;
  claude)
    AGENT_BIN="$CLAUDE_BIN"
    WORKSPACE_BASE="$CLAUDE_WORKSPACE_BASE"
    SESSION_PREFIX="claude-"
    ;;
  codex)
    AGENT_BIN="$CODEX_BIN"
    WORKSPACE_BASE="$CODEX_WORKSPACE_BASE"
    SESSION_PREFIX="codex-"
    ;;
esac

DIR="$WORKSPACE_BASE/${AGENT_DIR_PREFIX}${NAME}"
SESSION="${SESSION_PREFIX}${NAME}"

# ---- preflight -------------------------------------------------------------

if [ ! -d "$WORKSPACE_BASE" ]; then
  BACKEND_UPPER="$(printf '%s' "$BACKEND" | tr a-z A-Z)"
  echo "$BACKEND workspace base not available: $WORKSPACE_BASE" >&2
  echo "Set ${BACKEND_UPPER}_WORKSPACE_BASE in $CONFIG_FILE or via env." >&2
  exit 1
fi

mkdir -p "$DIR"

if ! command -v tmux >/dev/null 2>&1; then
  echo "tmux not found in PATH. Run the remote-agent-stack installer." >&2
  exit 1
fi

if ! command -v "$AGENT_BIN" >/dev/null 2>&1; then
  echo "$BACKEND CLI ('$AGENT_BIN') not found in PATH." >&2
  exit 1
fi

# ---- mailbox poke resolver -------------------------------------------------
# Mailbox skill (dfrysinger/skills) lives in the plugin install path once
# installed; fall back to local-dev paths. Empty if not installed OR if
# MAILBOX_INTEGRATION is not set to "true" in config.

MAILBOX_POKE=""
if [ "${MAILBOX_INTEGRATION:-false}" = "true" ]; then
  for _p in \
    "$HOME/.copilot/installed-plugins/_direct/dfrysinger--skills/skills/mailbox/scripts/mailbox-poke.sh" \
    "$HOME/.claude/plugins/repos/dfrysinger/skills/skills/mailbox/scripts/mailbox-poke.sh" \
    "$HOME/code/skills/skills/mailbox/scripts/mailbox-poke.sh" \
    "$HOME/.copilot/skills/mailbox/scripts/mailbox-poke.sh"; do
    [ -x "$_p" ] && { MAILBOX_POKE="$_p"; break; }
  done
fi

# ---- carry-over prompt -----------------------------------------------------
# Seeds a freshly rotated session with instructions to rebuild context from the
# retired one by reference, rather than by replaying its transcript. Emitted as
# a single line so it can be typed into the CLI input with tmux send-keys.

build_carryover_prompt() {
  local old="$1"
  local ss="$HOME/.copilot/session-state"
  cat <<EOF | tr '\n' ' '
You are continuing work from session $old, which was retired because its
transcript grew too large to reload. Before anything else, rebuild context from
it, skipping quietly over whatever does not exist: read $ss/$old/plan.md; read
the two newest files in $ss/$old/checkpoints/; list $ss/$old/files/; run
sqlite3 $ss/$old/session.db "SELECT id,title,status FROM todos WHERE status !=
'done'" for unfinished work; and read the tail of the conversation with the
session_store_sql tool using source=local: SELECT
turn_index,user_message,assistant_response FROM turns WHERE session_id='$old'
ORDER BY turn_index DESC LIMIT 12. Then summarize where things stand and what
you believe the next step is, and wait for my go-ahead before acting.
EOF
}

# ---- tmux client safety guards --------------------------------------------

# The tmux server is single threaded: one client it cannot write to blocks the
# event loop and freezes every session. Two invocations cause that, so both are
# refused below rather than attached.

# Inside a pane of this same tmux server. $TMUX alone is not enough, because
# callers sometimes blank it to bypass tmux's own nesting guard; compare the
# controlling terminal against the server's pane ttys as well.
inside_tmux() {
  [ -n "${TMUX:-}" ] && return 0
  _tty=$(tty 2>/dev/null) || return 1
  [ "${_tty#/dev/}" = "$_tty" ] && return 1
  tmux list-panes -a -F '#{pane_tty}' 2>/dev/null | grep -qx "$_tty"
}

# Attaching with stdout on a pipe creates a client tmux can block writing to
# once nobody drains it.
require_terminal() {
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "remote-agent: refusing to attach '$SESSION' without a terminal." >&2
    echo "remote-agent: this would wedge the tmux server. Run it from an interactive" >&2
    echo "remote-agent: shell, or inspect the session with:" >&2
    echo "remote-agent:   tmux capture-pane -p -t $SESSION" >&2
    exit 1
  fi
}

# Resolve an existing directory through symlinks and platform aliases.
physical_path() {
  [ -n "${1:-}" ] || return 1
  (cd "$1" 2>/dev/null && pwd -P)
}

session_matches_workspace() {
  local session="$1" session_path expected_path actual_path
  session_path="$(tmux display-message -p -t "=$session:" '#{session_path}' 2>/dev/null)" ||
    return 1
  [ -n "$session_path" ] || return 1
  expected_path="$(physical_path "$DIR")" || return 1
  actual_path="$(physical_path "$session_path")" || return 1
  [ "$actual_path" = "$expected_path" ]
}

refuse_mismatched_session() {
  local session="$1" session_path expected_path actual_path
  session_path="$(tmux display-message -p -t "=$session:" '#{session_path}' 2>/dev/null || true)"
  expected_path="$(physical_path "$DIR" 2>/dev/null || printf '%s' "$DIR")"
  actual_path="$(physical_path "$session_path" 2>/dev/null || printf '%s' "${session_path:-unknown}")"
  echo "tmux session '$session' belongs to another workspace." >&2
  echo "  session workspace: $actual_path" >&2
  echo "  expected workspace: $expected_path" >&2
  echo "Choose another name, or explicitly remove or rename the conflicting tmux session." >&2
  exit 1
}

# ---- attach if session exists ---------------------------------------------

if [ "$BACKEND" = "copilot" ] && tmux has-session -t "=$NAME" 2>/dev/null; then
  if session_matches_workspace "$NAME"; then
    SESSION="$NAME"
  fi
fi

if tmux has-session -t "=$SESSION" 2>/dev/null; then
  session_matches_workspace "$SESSION" || refuse_mismatched_session "$SESSION"
  [ -n "$MAILBOX_POKE" ] && ( "$MAILBOX_POKE" "$SESSION" ) &
  if inside_tmux; then
    exec tmux switch-client -t "=$SESSION"
  fi
  require_terminal
  exec tmux attach -t "=$SESSION"
fi

# ---- new session -----------------------------------------------------------

# ---- build backend-specific launch command --------------------------------

CMD=""
case "$BACKEND" in
  copilot)
    # Session-ID strategy: we want one Copilot session per agent name, with
    # no interactive picker. Copilot CLI accepts --session-id=<uuid> which
    # means "resume by ID, or set the UUID for a new session". So we pick a
    # UUID up front and Copilot does the right thing.
    #
    # UUID resolution, in priority order:
    #   1. Scan ~/.copilot/session-state/*/workspace.yaml for an existing
    #      session whose `cwd:` equals $DIR (the wrapper's canonical
    #      workspace). Prefer sessions with summary_count > 0 (i.e., real
    #      work has happened) over empty placeholder sessions; within each
    #      tier, pick the one with the most recent updated_at.
    #
    #      We key on cwd, NOT on the `name:` field: Copilot CLI's
    #      auto-summarizer rewrites `name:` in place whenever
    #      `user_named:` is false (e.g., after a `/clear`), so a session
    #      that originally was named "kilo" can end up named
    #      "Review Chat Transcript" — which would slip past a name match
    #      and leave us starting a brand-new empty session instead of
    #      resuming the real one.
    #
    #      Within each tier (real and empty), latest `updated_at` wins —
    #      i.e., the session most recently active. `updated_at` is bumped
    #      by real activity inside Copilot CLI (user messages, tool calls,
    #      summarizer runs), not by `tmux attach` (which only reconnects
    #      the terminal without restarting the running copilot process).
    #      So `updated_at` reliably identifies the session the user was
    #      last working in, which is what `ca` should resume — including
    #      across `/new` (the new session promotes itself by being the
    #      one with fresh activity).
    #
    #   2. Otherwise, fall back to a deterministic UUIDv5 derived from the
    #      name, so the first wrapper launch creates a stable UUID and
    #      subsequent launches resume it.
    UUID=""
    UUID_UPDATED=""
    UUID_TIER=""  # "real" (summary_count>0) wins over "empty" (summary_count==0)
    SESSION_STATE_DIR="$HOME/.copilot/session-state"
    RETIRED_FILE="$DIR/.ca-retired-sessions"
    if [ -d "$SESSION_STATE_DIR" ]; then
      for ws in "$SESSION_STATE_DIR"/*/workspace.yaml; do
        [ -r "$ws" ] || continue
        this_cwd="$(awk -F': ' '/^cwd: /{sub(/[[:space:]]+$/, "", $2); print $2; exit}' "$ws")"
        [ "$this_cwd" = "$DIR" ] || continue
        this_id="$(awk -F': ' '/^id: /{sub(/[[:space:]]+$/, "", $2); print $2; exit}' "$ws")"
        # Sessions the user chose to retire are never resumed again, so the
        # scan falls through to whatever session replaced them.
        if [ -s "$RETIRED_FILE" ] && grep -qxF "$this_id" "$RETIRED_FILE" 2>/dev/null; then
          continue
        fi
        this_updated="$(awk -F': ' '/^updated_at: /{sub(/[[:space:]]+$/, "", $2); print $2; exit}' "$ws")"
        this_count="$(awk -F': ' '/^summary_count: /{sub(/[[:space:]]+$/, "", $2); print $2; exit}' "$ws")"
        if [ -z "$this_count" ] || [ "$this_count" = "0" ]; then
          this_tier="empty"
        else
          this_tier="real"
        fi
        should_update=false
        if [ -z "$UUID" ]; then
          should_update=true
        elif [ "$UUID_TIER" = "empty" ] && [ "$this_tier" = "real" ]; then
          should_update=true
        elif [ "$UUID_TIER" = "real" ] && [ "$this_tier" = "empty" ]; then
          should_update=false
        elif [ "$this_updated" \> "$UUID_UPDATED" ]; then
          should_update=true
        fi
        if [ "$should_update" = "true" ]; then
          UUID="$this_id"
          UUID_UPDATED="$this_updated"
          UUID_TIER="$this_tier"
        fi
      done
    fi

    if [ -z "$UUID" ]; then
      UUID="$(python3 -c "import uuid,sys; print(uuid.uuid5(uuid.NAMESPACE_URL, 'remote-agent-stack/'+sys.argv[1]))" "$NAME")"
    fi

    # ---- offer to retire an oversized session ------------------------------
    # Copilot reloads a session's whole event log on resume, so one carried for
    # weeks grows into the gigabytes and drags on startup. Offer a fresh
    # session that inherits context by reference. Nothing is ever deleted — the
    # retired session stays on disk, resumable and minable.
    CARRYOVER_PROMPT=""
    _events="$SESSION_STATE_DIR/$UUID/events.jsonl"
    if [ -t 0 ] && [ "${SESSION_WARN_MB:-300}" -gt 0 ] && [ -r "$_events" ]; then
      _mb=$(( $(wc -c < "$_events") / 1048576 ))
      if [ "$_mb" -ge "${SESSION_WARN_MB}" ]; then
        echo "" >&2
        echo "Session for '$NAME' has grown to ${_mb} MB." >&2
        echo "  $UUID" >&2
        echo "Copilot replays the whole event log on resume, so this one will be slow" >&2
        echo "to start. Starting fresh keeps it on disk and carries context forward." >&2
        printf "Start a fresh session? [y/N/q] " >&2
        read -r _ans < /dev/tty || _ans=""
        case "$_ans" in
          q|Q) echo "Aborted." >&2; exit 0 ;;
          y|Y)
            _old="$UUID"
            printf '%s\n' "$_old" >> "$RETIRED_FILE"
            UUID="$(uuidgen | tr 'A-Z' 'a-z')"
            CARRYOVER_PROMPT="$(build_carryover_prompt "$_old")"
            echo "Retired $_old — starting fresh session $UUID." >&2
            ;;
        esac
      fi
    fi

    # Launch by --session-id alone, which Copilot treats as "resume this
    # session, or create it if the UUID is new" — so one command covers both
    # the first launch and every resume. We deliberately do NOT pass --name:
    # recent Copilot CLI rejects --name together with a --session-id that
    # resolves to an existing or remote session (i.e. every resume, plus a
    # cross-machine first launch that resolves to a remote session), and --name
    # is only a cosmetic label on the session anyway. Resume never relies on it
    # — the scan above keys on `cwd`, not `name`, precisely because Copilot's
    # auto-summarizer rewrites session names in place.
    CMD="$AGENT_BIN --session-id='$UUID' --remote"
    if [ "${ALLOW_ALL:-false}" = "true" ]; then
      CMD="$CMD --allow-all"
    fi
    ;;

  claude)
    # Claude Code stores per-project sessions at
    #   ~/.claude/projects/<slug>/*.jsonl
    # where <slug> is the working directory with `/` replaced by `-`
    # (leading `-` included). Resume the most recent session with
    # `claude --continue` when at least one session file exists;
    # otherwise start a fresh session.
    PROJECT_SLUG="$(printf '%s' "$DIR" | sed 's|/|-|g')"
    PROJECT_DIR="$HOME/.claude/projects/$PROJECT_SLUG"
    HAS_SESSION=false
    if [ -d "$PROJECT_DIR" ]; then
      for _f in "$PROJECT_DIR"/*.jsonl; do
        [ -r "$_f" ] && { HAS_SESSION=true; break; }
      done
    fi

    CMD="$AGENT_BIN"
    if [ "$HAS_SESSION" = "true" ]; then
      CMD="$CMD --continue"
    fi
    if [ "${ALLOW_ALL:-false}" = "true" ]; then
      CMD="$CMD --dangerously-skip-permissions"
    fi
    ;;

  codex)
    HAS_SESSION=false
    CODEX_SESSIONS_DIR="$HOME/.codex/sessions"
    if [ -d "$CODEX_SESSIONS_DIR" ] &&
       python3 - "$CODEX_SESSIONS_DIR" "$DIR" <<'PY'
import json
import os
import sys

root, expected_cwd = sys.argv[1:]
for directory, _, files in os.walk(root):
    for filename in files:
        if not filename.endswith(".jsonl"):
            continue
        path = os.path.join(directory, filename)
        try:
            with open(path, encoding="utf-8") as stream:
                record = json.loads(stream.readline())
        except (OSError, UnicodeError, json.JSONDecodeError):
            continue
        payload = record.get("payload") if isinstance(record, dict) else None
        cwd = payload.get("cwd") if isinstance(payload, dict) else None
        if cwd is None and isinstance(record, dict):
            cwd = record.get("cwd")
        if cwd == expected_cwd:
            raise SystemExit(0)
raise SystemExit(1)
PY
    then
      HAS_SESSION=true
    fi

    CMD="$AGENT_BIN"
    if [ "$HAS_SESSION" = "true" ]; then
      CMD="$CMD resume --last"
    fi
    if [ "${ALLOW_ALL:-false}" = "true" ]; then
      CMD="$CMD --dangerously-bypass-approvals-and-sandbox"
    fi
    ;;
esac

# Unlock the login keychain so credential helpers (git, gh, etc.) work in
# this SSH/tmux session. Done last so any interactive prompt above is settled
# before the password prompt appears. Quietly skipped if not on macOS.
if [ -f "$HOME/Library/Keychains/login.keychain-db" ] && command -v security >/dev/null 2>&1; then
  security unlock-keychain "$HOME/Library/Keychains/login.keychain-db" || true
fi

[ -n "$MAILBOX_POKE" ] && ( "$MAILBOX_POKE" "$SESSION" --wait ) &

# Type the carry-over prompt once the CLI is up. A single Enter often fails to
# submit in Copilot's input box, so press it until the input box is empty.
# The box spans the region between the last two horizontal rules; a long prompt
# wraps below the `❯` marker, so the whole region has to be checked rather than
# just the marker line.
_input_is_empty() {
  tmux capture-pane -p -t "$1" 2>/dev/null | awk '
    /^─+$/ { n++; sep[n] = NR }
    { line[NR] = $0 }
    END {
      if (n < 2) exit 1
      for (i = sep[n-1] + 1; i < sep[n]; i++) {
        t = line[i]; sub(/❯/, "", t); gsub(/[[:space:]]/, "", t)
        if (t != "") exit 1
      }
      exit 0
    }'
}

if [ -n "${CARRYOVER_PROMPT:-}" ]; then
  (
    for _ in $(seq 1 120); do
      if tmux has-session -t "$SESSION" 2>/dev/null && \
         tmux capture-pane -p -t "$SESSION" 2>/dev/null | tail -10 | grep -q '❯'; then
        break
      fi
      sleep 0.5
    done
    sleep 1
    tmux send-keys -t "$SESSION" -l -- "$CARRYOVER_PROMPT"
    sleep 0.5
    for _ in $(seq 1 10); do
      tmux send-keys -t "$SESSION" Enter
      sleep 1.5
      _input_is_empty "$SESSION" && break
    done
  ) &
fi

if inside_tmux; then
  tmux new-session -d -s "$SESSION" -c "$DIR" \; send-keys -t "$SESSION" "$CMD" Enter
  exec tmux switch-client -t "$SESSION"
fi

require_terminal
exec tmux new-session -s "$SESSION" -c "$DIR" \; send-keys "$CMD" Enter
